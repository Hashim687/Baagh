# Copy this file to .env and change secrets before any public deployment.
BAAGH_ENV=development
BAAGH_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
BAAGH_ADMIN_NAME=Baagh Administrator
BAAGH_ADMIN_USERNAME=baagh.admin
BAAGH_ADMIN_PHONE=9000000000
BAAGH_ADMIN_PASSWORD=BgH!7pQ#K26_vN9$Zr4@La8
BAAGH_SEED_DEMO=true
BAAGH_TOKEN_TTL_SECONDS=86400
BAAGH_OTP_TTL_SECONDS=300

# ---- Phone OTP (sign-up verification, no admin approval) ----
# Without any of these, development mode shows the code on screen and sends no SMS.
# BAAGH_ENV=production REFUSES sign-ups until one provider below is configured.
#
# Option 1 (recommended, handles India's DLT rules): Twilio Verify
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-me
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Option 2: Twilio SMS from your own number (Baagh generates the code)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-me
# TWILIO_FROM_PHONE=+1xxxxxxxxxx
#
# OTP limits (defaults shown)
# BAAGH_OTP_RESEND_SECONDS=60
# BAAGH_OTP_MAX_PER_HOUR=5
# BAAGH_IP_OTP_LIMIT=40

# Optional absolute database path.
# BAAGH_DB_PATH=C:\\BaaghData\\baagh.sqlite3
